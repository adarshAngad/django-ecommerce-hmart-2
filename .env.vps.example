# Copy to .env.vps on your VPS (never commit .env.vps).
# Public DNS name you control (must point to this server before HTTPS will work).
SITE_DOMAIN=shop.example.com

# Django
SECRET_KEY=replace-with-long-random-string
DEBUG=False

# Postgres (change defaults for anything public-facing)
POSTGRES_USER=django
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=ecommerce
