# Copy to .env.docker and adjust. Used by: docker compose --env-file .env.docker up
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DOCKER=1
DOCKER_BEHIND_HTTP=1
ENABLE_PROMETHEUS=1
DOCKER_JSON_LOGS=1
WEB_CONCURRENCY=2
# Comma-separated hosts when you open the site from another machine (LAN IP or hostname)
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
DATABASE_URL=postgres://django:django@db:5432/ecommerce
